<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Beauty Products"
            android:textColor="#9C536F"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep your beauty collection organized"
            android:textColor="#806D73"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnAddNewProduct"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="+ Add New Product"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C87999"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnReminder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Expired Reminder"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9C536F"
            android:layout_marginBottom="24dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Collection"
            android:textColor="#9C536F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/productContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No products added yet."
                android:textColor="#806D73"
                android:textSize="15sp"
                android:gravity="center"
                android:padding="24dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
